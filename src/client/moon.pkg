// moonetcd/client: the native gRPC transport. One `Client` dials one or more
// etcd endpoints (multi-endpoint failover via the net ManagedChannel for unary
// and server/client streaming) and owns a multiplexed channel per bidi session
// (Watch, Lease KeepAlive) so the stream can reconnect from the last revision.
//
// Native only: the transport opens real TCP connections.
supported_targets = "native"

import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/async",
  "moonbitstack/moonrpc/net",
  "moonbitstack/moonrpc/wire",
  "moonbitstack/moonrpc/proto",
  "moonbitstack/moonhttp/header",
  "moonbitstack/moonhttp/http1",
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moonetcd",
}

import {
  "moonbitstack/moonetcd",
} for "wbtest"
